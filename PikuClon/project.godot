; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PikuClon"
run/main_scene="res://escenas/pueblo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
MapaUI="*res://escenas/mapa_ui.tscn"
ArmarioUI="*res://escenas/armario_ui.tscn"
HudUI="*res://escenas/hud_ui.tscn"
MusicaManager="*res://scripts/musica_manager.gd"
Pantalla="*res://scripts/pantalla.gd"
PausaUI="*res://escenas/pausa_ui.tscn"
ControlesTactiles="*res://scripts/controles_tactiles.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://recursos/fuentes/Baloo2.ttf"
theme/default_font_size=16

[rendering]

textures/vram_compression/import_etc2_astc=true
